*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.so
*.cpython*.so
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
.coveragerc
coverage.xml
*.cover
*.log
.gitmailmap

# Virtual environments
.venv/
venv/
ENV/
env/
.venv*

# IPython
*.ipynb_checkpoints
ipython_config.py
profile_default/

# Jupyter
.ipynb
.ipynb_checkpoints
*.widget*.js

