build/
build_cxx11/
build_cxx03/
build_test/
build_backend/
build_temp/
.wheelhouse/
eggs/
.cmake/
cmake-build-*/
cmake_*
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
Makefile
*.cmake
!cmake/**
*.ninja
!ninja/**
CTestTestfile.cmake
_deps/

# scikit-build
.skbuild/
*.egg-info/
setup.py

